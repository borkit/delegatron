# Required only for the providers you use (local Ollama presets need none)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# Optional: E2B Sandbox (if using E2B instead of Docker)
# E2B_API_KEY=e2b_...

# Optional: Pipeline Configuration
# DELEGATRON_MAX_ITERATIONS=5
# DELEGATRON_MAX_COST_USD=5.00   # 0 = no limit
# DELEGATRON_MAX_WALL_TIME=60
# DELEGATRON_SANDBOX=docker
# DELEGATRON_LOG_LEVEL=INFO
